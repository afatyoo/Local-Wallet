WEB_PORT=3000

# MySQL (change these)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=change_me_password

# Generate two different random values:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_session_secret
TFA_ENCRYPTION_KEY=change_me_tfa_encryption_key

# Set true behind an HTTPS reverse proxy
COOKIE_SECURE=false

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:3000
# Notification scan interval in milliseconds (default: 6 hours, minimum: 1 minute)
NOTIFICATION_SCAN_INTERVAL_MS=21600000
