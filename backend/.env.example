# Backend environment variables
# Copy this file to .env and fill in your values

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finance_db

# JWT secret for short-lived TFA challenges — REQUIRED
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# TFA secret encryption key — recommended, use a different random value from JWT_SECRET
# If omitted, the backend falls back to JWT_SECRET.
TFA_ENCRYPTION_KEY=

# Server port
PORT=3001

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Use true when the app is publicly served through HTTPS
COOKIE_SECURE=false

# API protection per client IP (15-minute windows)
GLOBAL_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Receipt storage and optional SMTP notifications
RECEIPT_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:3000
NOTIFICATION_SCAN_INTERVAL_MS=21600000
