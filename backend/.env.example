# Backend environment variables
# Copy this file to .env and fill in your values

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Each sensitive value can alternatively use a mounted file, for example:
# MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
MYSQL_DATABASE=finance_db

# JWT secret for short-lived TFA challenges — REQUIRED
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# TFA secret encryption key — REQUIRED and must differ from JWT_SECRET
TFA_ENCRYPTION_KEY=
# TFA_ENCRYPTION_KEY_FILE=/run/secrets/tfa_encryption_key

# Server port
PORT=3001

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Leave empty to derive from X-Forwarded-Proto, or force true on HTTPS-only deployments
COOKIE_SECURE=
BCRYPT_ROUNDS=12
SESSION_IDLE_TIMEOUT_MINUTES=30

# API protection per client IP (15-minute windows)
GLOBAL_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Receipt storage and optional SMTP notifications
RECEIPT_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=
APP_URL=http://localhost:3000
NOTIFICATION_SCAN_INTERVAL_MS=21600000
